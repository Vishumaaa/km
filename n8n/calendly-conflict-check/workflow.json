    {
      "parameters": {
        "sendTo": "={{ $('Detect Conflicts').item.json.inviteeEmail }}",
        "subject": "=Need to reschedule: {{ $(\"Detect Conflicts\").item.json.title }}",
        "emailType": "text",
        "message": "=Hi {{ $(\"Detect Conflicts\").item.json.inviteeName }},\n\nThank you for booking time. Unfortunately a scheduling conflict came up for the slot you chose. Could you please pick another time using the same booking link?\n\nSorry for the inconvenience and thank you!",
        "options": {}
