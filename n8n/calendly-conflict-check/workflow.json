    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 20,
        "filters": {
          "q": "(\"let's connect\" OR \"lets connect\" OR \"how about\" OR \"are you free\" OR \"works for me\" OR \"sometime\" OR \"this afternoon\" OR \"tomorrow afternoon\" OR \"next week\") newer_than:7d",
          "readStatus": "both"
