    {
      "parameters": {
        "resource": "event",
        "returnAll": true,
        "filters": {
          "custom": "={{ \"start/dateTime lt '\" + $('Normalize Booking').item.json.end + \"' and end/dateTime gt '\" + $('Normalize Booking').item.json.start + \"'\" }}"
