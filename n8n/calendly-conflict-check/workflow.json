        "start": "={{ $('Detect Conflicts').item.json.start }}",
        "end": "={{ $('Detect Conflicts').item.json.end }}",
        "additionalFields": {
          "attendees": ["={{ $('Detect Conflicts').item.json.inviteeEmail }}"],
          "summary": "={{ $(\"Detect Conflicts\").item.json.title }} - {{ $(\"Detect Conflicts\").item.json.inviteeName }}"
        }
      },
      "id": "144fea63-9ebc-402d-a2e8-5b3ec2f143e2",
      "name": "Add to Google Calendar",
