      "id": "fe0899f4-ea7c-4186-bb75-ac023cc4adcf",
      "name": "Outlook Mail Search",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [560, 752],
      "alwaysOutputData": true
    },
    {
      "parameters": { "numberInputs": 6 },
      "id": "beb2d75c-31f1-4d4d-8f86-9e286ece7dad",
      "name": "Combine All Checks",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [880, 384]
    },
    {
      "parameters": {
        "jsCode": "const booking = $('Normalize Booking').first().json;\nconst items = $input.all().map(i => i.json).filter(j => Object.keys(j).length > 0);\nconst calendarHits = items.filter(j => j.start && j.end);\nconst emailHits = items.filter(j => !(j.start && j.end) && (j.snippet || j.bodyPreview || j.subject));\nconst hasConflict = calendarHits.length > 0 || emailHits.length > 0;\nconst lines = [];\ncalendarHits.forEach(e => lines.push('Calendar: ' + (e.summary || e.subject || 'Busy')));\nemailHits.forEach(m => lines.push('Email: ' + (m.subject || '') + ' - ' + (m.snippet || m.bodyPreview || '')));\nreturn [{ json: { ...booking, hasConflict, calendarConflicts: calendarHits.length, emailSignals: emailHits.length, summary: lines.join('\\n') } }];"
      },
      "id": "7a88d73b-cd67-4f93-ab25-06550775d6e7",
      "name": "Detect Conflicts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1152, 384]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            { "leftValue": "={{ $json.hasConflict }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dbd3fba3-dd5e-4211-8237-68a2e1e68716",
      "name": "Conflict Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1408, 384]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "user": { "__rl": true, "mode": "username", "value": "<Slack username of the host>" },
        "message": "=Possible conflict for *{{ $json.title }}* with {{ $json.inviteeName }} ({{ $json.inviteeEmail }}) at {{ $json.start }}\n\n{{ $json.summary }}\n\nKeep this slot or ask them to reschedule?",
        "approvalOptions": { "values": { "approvalType": "double", "approveLabel": "Keep slot", "disapproveLabel": "Reschedule" } },
        "options": {}
      },
      "id": "28786f88-ade3-4d4a-926a-656ea2798add",
      "name": "Slack: Ask Host to Approve",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [1680, 272]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            { "leftValue": "={{ $json.data.approved }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f0da0e11-df41-411e-95e6-34af7ccc371d",
      "name": "Host Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1952, 272]
    },
    {
      "parameters": {
